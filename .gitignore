# Этот репозиторий ПУБЛИЧНЫЙ: всё, что сюда попадёт, увидит кто угодно.
# Поэтому список работает наоборот: запрещено всё, кроме перечисленного.
# Случайно закинутый в папку config.json, tokens.json или links.tsv
# просто не попадёт в коммит.

*

!.gitignore
!.gitattributes
!.nojekyll
!index.html
!img/
!img/**
!og.png
# помощник для работы без интернета
!sw.js
# зашифрованные гайды: по файлу на артикул
!g/
!g/**
# тексты лотов: тоже зашифрованы, нужны только владельцу
!l/
!l/**

# Явный запрет на случай, если правила выше кто-то ослабит
config.json
tokens.json
links.tsv
links.csv
*.zip
*.bak
.env
.env.*
